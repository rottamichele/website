  .circle-6.active .split-column p {
    color: #fcf6ef !important;
    opacity: 0.95;
  }

  .circle-6.active .left-column {
    border-right: 2px solid var(--color-primary) !important;
  }

  .split-columns-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    align-items: start; 
  }
  .split-column {
    padding: 0 35px;
    box-sizing: border-box;
  }
  .left-column {
    border-right: 2px solid var(--color-accent);
    text-align: right;
  }
  .right-column {
    text-align: left;
  }
  .split-column .column-subtitle {
    font-size: 1.35rem;
    font-weight: 700;
