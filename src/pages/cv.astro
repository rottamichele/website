---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CV - Portfolio">
  <div class="cv-canvas-container">
    
    <!-- Sfondo/Overlay per intercettare i click all'esterno -->
    <div class="canvas-overlay" id="canvasOverlay"></div>

    <!-- Titolo Curriculum al 20% dall'alto -->
    <h1 class="page-title">
      <span class="MR-word">Curriculum</span> <span class="dot-word">.</span>
    </h1>

    <!-- Canvas con forme geometriche -->
    <div class="shapes-canvas">

      <!-- 1. Working Experiences (Primary) -->
      <div class="geom-shape circle-1" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title"><span class="highlight-letter">W</span>orking <span class="highlight-letter">E</span>xperiences</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3><span class="highlight-word">Mechanical</span> Designer</h3>
              <span class="cv-company"><span class="highlight-letter">@ SACMI | 2023 - Now</span></span>
              <p>In engineering department I design press for ceramic casting. 
                The journey include mechanical calculations, 3D/2D modelling, FEM analysis, 
                hydraulic and pneumatic systems design. In these processes I work in a 
                multidisciplinary team (mechanical, electrical and automation), 
                interacting with the purchasing department, suppliers and the workshop staff. 
                This implies to work with cost estimations, quotations, project management and people 
                coordination.</p>
            </div>
            <div class="cv-item">
              <h3>Junior Control <span class="highlight-word">Software</span> Engineer</h3>
              <span class="cv-company"><span class="highlight-letter">@ Eldor Corporation | 2020 - 2022</span></span>
              <p>In R&D department I used to develop software control algorithms for static converter 
                (Power Electronics) for automotive industry (onboard battery charger). 
                I worked with hardware and mechanical departments in developing and testing 
                prototypes of different kind of converters (PFC, DC-DC, Buck-Boost, etc.). 
                I’ve been involved in safety analysis, thermal models, laboratory and endurance tests.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Education (Accent) -->
      <div class="geom-shape circle-2" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title"><span class="highlight-primary">E</span>ducation</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>M.Sc Automation and Control Engineer</h3>
              <span class="cv-company"><span class="cv-institution">@ Politecnico di Milano</span> | 2017 - 2020</span>
            </div>
            <div class="cv-item">  
              <h3>B.Sc Mechatronic Engineer</h3>
              <span class="cv-company"><span class="cv-institution">@ Università degli Studi di Padova</span> | 2014 - 2017</span>
            </div>
            <div class="cv-item">  
              <h3>High School Diploma (Scientifico)</h3>
              <span class="cv-company"><span class="cv-institution">@ Liceo Scientifico</span> | 2009 - 2014</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Languages (Secondary) -->
      <div class="geom-shape circle-3" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title"><span class="highlight-letter">L</span>anguages</h2>
          <div class="shape-content">
            <div class="lang-row">
              <span class="lang-name">Italiano 🇮🇹</span>
              <span class="lang-desc">Mother tongue</span>
              <div class="lang-bar"><div class="lang-progress p-100"></div></div>
            </div>
            <div class="lang-row">
              <span class="lang-name">English 🇬🇧</span>
              <span class="lang-desc">Professional</span>
              <div class="lang-bar"><div class="lang-progress p-80"></div></div>
            </div>
            <div class="lang-row">
              <span class="lang-name">Spanish 🇪🇸</span>
              <span class="lang-desc">Beginner</span>
              <div class="lang-bar"><div class="lang-progress p-30"></div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Informatic Skills (Primary) -->
      <div class="geom-shape circle-4" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title"><span class="highlight-letter">I</span>nformatic <span class="highlight-letter">S</span>kills</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>3D/2D Modelling</h3>
              <p>SolidWorks, AutoCAD, BricsCAD, SketchUp</p>
            </div>
            <div class="cv-item">
              <h3>Development & Code</h3>
              <p>Python, C, Astro, HTML/CSS, Git</p>
            </div>
            <div class="cv-item">
              <h3>Computing Environment</h3>
              <p>Matlab, Simulink, Ansys Mechanical</p>
            </div>
            <div class="cv-item">
              <h3>Graphics</h3>
              <p>InDesign, LaTex, RawTherapee</p>
            </div>
            <div class="cv-item">
              <h3>Other</h3>
              <p>MS Office, TeamCenter, SAP</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Hobbies & Interests (Secondary) -->
      <div class="geom-shape circle-5" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title closed-only-title">
            Hobby<br>&<br>Interests
          </h2>

          <h2 class="shape-title open-only-title">
            <span class="highlight-letter">H</span>obby & <span class="highlight-letter">I</span>nterests
          </h2>

          <div class="shape-content">
            <div class="cv-item">
              <p class="hobbies-intro">In my free time I love to dedicate myself to:</p>
              <ul class="hobbies-list-stacked">
                <li>🚴 Cycling</li>
                <li>🍺 Beer & Homebrewing</li>
                <li>🌾 Agriculture</li>
                <li>⛰️ Mountain</li>
                <li>🎵 Music</li>
                <li>🪵 Woodworking</li>
              </ul>
              <p class="hobbies-outro">
                Curious to see what I create? Jump straight into my hands-on projects in the <a href="/portfolio" class="portfolio-link">Portfolio</a> section! 🚀
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- 6. Certifications & Projects (Accent) -->
      <div class="geom-shape circle-6" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <!-- Titolo da chiuso con colore Primary (viola) -->
          <h2 class="shape-title closed-only-title circle-6-closed-title">
            Certifications<br>&<br>Projects
          </h2>

          <div class="shape-content">
            <div class="split-columns-container">
              <!-- Colonna Sinistra: Certifications & Courses -->
              <div class="split-column left-column">
                <h3 class="column-subtitle"><span class="highlight-letter">C</span>ertifications & Courses</h3>
                <div class="cv-item">
                  <h4 class="item-title-primary">CAPM Certification</h4>
                  <p>Certification currently being obtained</p>
                </div>
                <div class="cv-item">
                  <h4 class="item-title-primary">BOSCH Hydraulic Course</h4>
                  <p>Basic + Advanced Module</p>
                </div>
              </div>

              <!-- Colonna Destra: Projects -->
              <div class="split-column right-column">
                <h3 class="column-subtitle"><span class="highlight-letter">P</span>rojects</h3>
                <div class="cv-item">
                  <h4 class="item-title-primary">Analysis and development of systems for the active monitoring of the health and wear of helicopters</h4>
                  <p>Master Thesis in Machine Learning, Anomaly Detection, Predictive Maintenance, AI</p>
                </div>
                <div class="cv-item">
                  <h4 class="item-title-primary">Automation of a storage warehouse</h4>
                  <p>University project with ABB PLC</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const shapes = document.querySelectorAll('.geom-shape');
    const overlay = document.getElementById('canvasOverlay');

    function closeAllShapes() {
      shapes.forEach(s => s.classList.remove('active'));
      overlay?.classList.remove('visible');
    }

    shapes.forEach(shape => {
      const closeBtn = shape.querySelector('.close-btn');

      shape.addEventListener('click', (e) => {
        if (shape.classList.contains('active')) return;

        closeAllShapes();
        shape.classList.add('active');
        overlay?.classList.add('visible');
        e.stopPropagation();
      });

      closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAllShapes();
      });
    });

    overlay?.addEventListener('click', () => {
      closeAllShapes();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllShapes();
      }
    });
  });
</script>

<style>
  .cv-canvas-container {
    width: 100%;
    max-width: 1400px;
    height: calc(100vh - 82px);
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Titolo al 20% dall'alto */
  .page-title {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 3.2rem;
    font-weight: 700;
    margin: 0;
    text-align: center;
    z-index: 1;
    pointer-events: none;
  }

  .MR-word { color: var(--color-primary); }
  .dot-word { color: var(--color-accent); }

  /* Overlay per intercettare i click all'esterno */
  .canvas-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(2px);
    z-index: 900;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .canvas-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .shapes-canvas {
    position: relative;
    width: 100%;
    flex-grow: 1;
    min-height: 600px;
  }

  /* Stile base per tutti i cerchi (250px uniformi) */
  .geom-shape {
    position: absolute;
    width: 250px;
    height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    cursor: pointer;
    border-radius: 50%;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                width 0.4s ease, 
                height 0.4s ease, 
                border-radius 0.4s ease,
                background-color 0.3s ease;
    box-sizing: border-box;
    padding: 20px;
    overflow: hidden;
    z-index: 5;
  }

  .shape-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .shape-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    padding: 0 5px;
  }

  /* Gestione visibilità titoli per cerchi a stato chiuso/aperto */
  .geom-shape:not(.active) .open-only-title {
    display: none !important;
  }
  .geom-shape.active .closed-only-title {
    display: none !important;
  }

  .shape-content {
    opacity: 0;
    max-height: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    text-align: left;
    width: 100%;
    overflow-y: auto;
  }

  .close-btn {
    display: none;
    position: absolute;
    top: 30px;
    right: 35px;
    background: transparent;
    border: none;
    font-size: 2.2rem;
    cursor: pointer;
    color: inherit;
    z-index: 30;
    line-height: 1;
  }

  /* --- ANIMAZIONI DI OSCILLAZIONE --- */
  @keyframes floatDynamic1 {
    0% { transform: translate(0, 0); }
    33% { transform: translate(-5px, -7px); }
    66% { transform: translate(6px, 4px); }
    100% { transform: translate(0, 0); }
  }

  @keyframes floatDynamic2 {
    0% { transform: translate(0, 0); }
    33% { transform: translate(6px, -5px); }
    66% { transform: translate(-5px, 6px); }
    100% { transform: translate(0, 0); }
  }

  /* --- DISTRIBUZIONE DEI TRE COLORI --- */
  
  /* 1. Working Experiences (Primary) */
  .circle-1 {
    background-color: var(--color-primary); color: #fcf6ef;
    top: 3%; left: 8%;
    animation: floatDynamic1 4.5s ease-in-out infinite;
    box-shadow: 0 12px 30px rgba(102, 98, 156, 0.25);
  }
  .circle-1:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  /* 2. Education (Accent) */
  .circle-2 {
    background-color: var(--color-accent); color: #fcf6ef;
    top: 6%; right: 13%;
    animation: floatDynamic2 5s ease-in-out infinite 0.7s;
    box-shadow: 0 12px 30px rgba(253, 197, 126, 0.3);
  }
  .circle-2:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  /* 3. Languages (Secondary) */
  .circle-3 {
    background-color: var(--color-secondary); color: #fcf6ef;
    top: 55%; left: 3%;
    animation: floatDynamic1 5.5s ease-in-out infinite 1.4s;
    box-shadow: 0 12px 30px rgba(217, 122, 102, 0.25);
  }
  .circle-3:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  /* 4. Informatic Skills (Primary) */
  .circle-4 {
    background-color: var(--color-primary); color: #fcf6ef;
    top: 55%; left: 50%;
    animation: floatDynamic2 4.8s ease-in-out infinite 0.3s;
    box-shadow: 0 12px 30px rgba(102, 98, 156, 0.25);
  }
  .circle-4:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  /* 5. Hobbies & Interests (Secondary) */
  .circle-5 {
    background-color: var(--color-secondary); color: #fcf6ef;
    bottom: 8%; right: 6%;
    animation: floatDynamic1 5.2s ease-in-out infinite 1s;
    box-shadow: 0 12px 30px rgba(217, 122, 102, 0.25);
  }
  .circle-5:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  /* 6. Certifications & Projects (Accent) */
  .circle-6 {
    background-color: var(--color-accent); color: #fcf6ef;
    top: 35%; left: 28%;
    animation: floatDynamic2 4.6s ease-in-out infinite 0.5s;
    box-shadow: 0 12px 30px rgba(253, 197, 126, 0.3);
  }
  .circle-6:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  /* Titolo specifico cerchio 6 da chiuso (Primary/Viola) */
  .circle-6-closed-title {
    color: var(--color-primary) !important;
  }

  /* --- STATO ATTIVO GENERALE --- */
  .geom-shape.active {
    position: fixed !important;
    top: 50% !important; 
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    animation: none !important;
    z-index: 1000 !important;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4) !important;
  }

  .geom-shape.active .shape-content {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .geom-shape.active .close-btn {
    display: block !important;
  }

  /* --- STATO ATTIVO CERCHIO 1 (Working Experiences - Primary) --- */
  .circle-1.active { 
    width: min(95vw, 95vh) !important; 
    height: min(95vw, 95vh) !important; 
    border-radius: 50% !important; 
    padding: 60px 80px !important; 
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    background-color: var(--color-primary) !important;
    color: #fcf6ef !important;
  }
  .circle-1.active .shape-inner { display: flex !important; flex-direction: column !important; justify-content: center !important; align-items: center !important; text-align: center !important; width: 100% !important; height: 100% !important; }
  .circle-1.active .shape-title { font-size: 1.8rem; border-bottom: 2px solid var(--color-accent); width: 60%; margin: 0 auto 15px auto !important; padding-bottom: 8px; text-align: center; }
  .circle-1.active .highlight-letter { color: var(--color-accent); }
  .circle-1.active .highlight-word { color: var(--color-accent); }
  .circle-1.active .shape-content { max-height: none !important; overflow-y: visible !important; width: 100% !important; }
  .circle-1.active .cv-item { margin-bottom: 15px; text-align: center; }
  .circle-1.active .cv-item h3 { margin: 0 0 2px 0; font-size: 1.1rem; text-align: center; }
  .circle-1.active .cv-company { font-size: 0.82rem; opacity: 0.85; display: block; margin-bottom: 4px; text-align: center; }
  .circle-1.active .cv-item p { font-size: 0.88rem; line-height: 1.4; margin: 0 auto; max-width: 650px; text-align: justify; text-justify: inter-word; }

  /* --- STATO ATTIVO CERCHIO 2 (Education - Accent -> Dettagli Primary) --- */
  .circle-2.active { 
    width: min(90vw, 90vh) !important; 
    height: min(90vw, 90vh) !important; 
    border-radius: 50% !important; 
    padding: 60px 80px !important; 
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    background-color: var(--color-accent) !important;
    color: #fcf6ef !important;
  }
  .circle-2.active .shape-inner { display: flex !important; flex-direction: column !important; justify-content: center !important; align-items: center !important; width: 100% !important; height: 100% !important; }
  .circle-2.active .shape-title { font-size: 1.8rem; border-bottom: 2px solid var(--color-primary); width: 60%; margin: 0 auto 20px auto !important; padding-bottom: 8px; text-align: center !important; color: #fcf6ef; }
  .circle-2.active .highlight-primary { color: var(--color-primary); font-weight: 700; }
  .circle-2.active .cv-institution { color: var(--color-primary); font-weight: 700; }
  .circle-2.active .shape-content { max-height: none !important; overflow-y: visible !important; width: 100% !important; max-width: 600px; margin: 0 auto; text-align: left !important; color: #fcf6ef; }
  .circle-2.active .cv-item { text-align: left !important; margin-bottom: 18px; }
  .circle-2.active .cv-item h3 { text-align: left !important; margin: 0 0 2px 0; font-size: 1.15rem; color: #fcf6ef; }
  .circle-2.active .cv-company { text-align: left !important; display: block; font-size: 0.85rem; opacity: 0.95; color: #fcf6ef; }

  /* --- STATO ATTIVO CERCHIO 3 (Languages - Secondary/Verde -> Dettagli Accent) --- */
  .circle-3.active { 
    width: min(90vw, 90vh) !important; 
    height: min(90vw, 90vh) !important; 
    border-radius: 50% !important; 
    padding: 60px 90px !important; 
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
    background-color: var(--color-secondary) !important; 
    color: #fcf6ef !important; 
  }
  .circle-3.active .shape-inner { display: flex !important; flex-direction: column !important; justify-content: center !important; align-items: center !important; text-align: center !important; width: 100% !important; height: 100% !important; }
  .circle-3.active .shape-title { font-size: 2rem; border-bottom: 2px solid var(--color-accent); width: 60%; margin: 0 auto 35px auto !important; padding-bottom: 12px; text-align: center !important; color: #fcf6ef !important; }
  .circle-3.active .highlight-letter { color: var(--color-accent); }
  .circle-3.active .shape-content { max-height: none !important; overflow-y: visible !important; width: 100% !important; max-width: 580px; margin: 0 auto; }
  .circle-3.active .lang-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; width: 100%; gap: 20px; }
  .circle-3.active .lang-row:last-child { margin-bottom: 0; }
  .circle-3.active .lang-name { font-weight: 700; font-size: 1.15rem; text-align: left; flex: 1.2; color: #fcf6ef; }
  .circle-3.active .lang-desc { font-size: 1rem; opacity: 0.95; text-align: left; flex: 1.5; color: #fcf6ef; }
  .circle-3.active .lang-bar { flex: 1; height: 9px; background: rgba(252, 246, 239, 0.25); border-radius: 5px; overflow: hidden; }
  .circle-3.active .lang-progress { height: 100%; background: var(--color-accent); border-radius: 5px; }
  .circle-3.active .p-100 { width: 100%; }
  .circle-3.active .p-80 { width: 75%; }
  .circle-3.active .p-30 { width: 35%; }

  /* --- STATO ATTIVO CERCHIO 4 (Informatic Skills - Primary) --- */
  .circle-4.active { 
    width: min(90vw, 90vh) !important; 
    height: min(90vw, 90vh) !important; 
    border-radius: 50% !important; 
    padding: 60px 80px !important; 
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    background-color: var(--color-primary) !important; 
    color: #fcf6ef !important; 
  }
  .circle-4.active .shape-inner { display: flex !important; flex-direction: column !important; justify-content: center !important; align-items: center !important; width: 100% !important; height: 100% !important; }
  .circle-4.active .shape-title { font-size: 1.8rem; border-bottom: 2px solid var(--color-accent); width: 60%; margin: 0 auto 20px auto !important; padding-bottom: 8px; text-align: center !important; color: #fcf6ef !important; }
  .circle-4.active .highlight-letter { color: var(--color-accent); }
  .circle-4.active .shape-content { max-height: none !important; overflow-y: visible !important; width: 100% !important; max-width: 600px; margin: 0 auto; text-align: left !important; }
  .circle-4.active .cv-item { text-align: left !important; margin-bottom: 15px; }
  .circle-4.active .cv-item h3 { text-align: left !important; margin: 0 0 2px 0; font-size: 1.1rem; color: #fcf6ef; }
  .circle-4.active .cv-item p { text-align: left !important; margin: 0; font-size: 0.9rem; opacity: 0.9; color: #fcf6ef; }

  /* --- STATO ATTIVO CERCHIO 5 (Hobby & Interests - Secondary/Verde -> Dettagli Accent) --- */
  .circle-5.active { 
    width: min(90vw, 90vh) !important; 
    height: min(90vw, 90vh) !important; 
    border-radius: 50% !important; 
    padding: 60px 80px !important; 
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
    background-color: var(--color-secondary) !important;
    color: #fcf6ef !important;
  }
  .circle-5.active .shape-inner { justify-content: center !important; align-items: center !important; text-align: center !important; width: 100% !important; height: 100% !important; }
  
  .circle-5.active .open-only-title { 
    font-size: 1.8rem !important; 
    border-bottom: 2px solid var(--color-accent) !important; 
    width: 60%; 
    margin: 0 auto 12px auto !important; 
    padding-bottom: 8px; 
    text-align: center !important; 
    color: #fcf6ef;
  }
  .circle-5.active .highlight-letter { color: var(--color-accent); }

  .circle-5.active .shape-content { max-height: none !important; overflow-y: visible !important; text-align: center !important; width: 100% !important; max-width: 480px; margin: 0 auto; color: #fcf6ef; }
  .circle-5.active .cv-item { text-align: center !important; margin-bottom: 0; }
  .circle-5.active .hobbies-intro { margin: 0 0 10px 0; font-size: 0.92rem; opacity: 0.9; color: #fcf6ef; }
  .circle-5.active .hobbies-list-stacked { list-style: none; padding: 0; margin: 0 0 14px 0; display: flex; flex-direction: column; gap: 6px; align-items: center; color: #fcf6ef; }
  .circle-5.active .hobbies-list-stacked li { font-size: 0.95rem; font-weight: 500; }
  .circle-5.active .hobbies-outro { margin: 0; font-size: 0.9rem; opacity: 0.95; line-height: 1.45; color: #fcf6ef; }
  .circle-5.active .portfolio-link { color: var(--color-accent); font-weight: 700; text-decoration: underline; transition: opacity 0.2s ease; }
  .circle-5.active .portfolio-link:hover { opacity: 0.8; }

  /* --- STATO ATTIVO CERCHIO 6 (Certifications & Projects - Accent) --- */
  .circle-6.active { 
    width: min(95vw, 95vh) !important; 
    height: min(95vw, 95vh) !important; 
    border-radius: 50% !important; 
    padding: 60px 80px !important; 
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    background-color: var(--color-accent) !important;
    color: #fcf6ef !important;
  }
  .circle-6.active .shape-inner {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    width: 100% !important;
    height: 100% !important;
  }
  .circle-6.active .shape-content { 
    max-height: none !important; 
    overflow-y: visible !important; 
    width: 100% !important;
    max-width: 780px;
    margin: 0 auto;
    color: #fcf6ef;
  }

  /* Titoli delle due sezioni (chiari) */
  .circle-6.active .split-column .column-subtitle {
    color: #fcf6ef !important;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 20px 0;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 6px;
  }
  .circle-6.active .split-column .highlight-letter {
    color: #fcf6ef !important;
  }

  /* Titoli dei singoli elementi (CAPM, Bosch, Tesi, Warehouse) in viola primary */
  .circle-6.active .split-column .item-title-primary {
    color: var(--color-primary) !important;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 4px 0;
