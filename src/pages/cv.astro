  }
  .split-column p {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.88;
    line-height: 1.35;
    color: #fcf6ef;
  }

  .cv-item { margin-bottom: 20px; }

/* --- ADATTAMENTO MOBILE --- */
  @media (max-width: 768px) {
    .cv-canvas-container {
      height: auto !important;
      min-height: 100vh;
      overflow-x: hidden !important;
      overflow-y: visible !important;
      padding: 20px 15px 80px 15px;
    }

    .page-title {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      margin: 15px 0 35px 0;
      font-size: 2.5rem;
    }

    .shapes-canvas {
      height: auto !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 35px;
    }

    /* Cerchi chiusi con movimento fluido abilitato */
    .geom-shape {
      position: relative !important;
      top: auto !important; 
      left: auto !important; 
      right: auto !important; 
      bottom: auto !important;
      width: 230px !important; 
      height: 230px !important;
      border-radius: 50% !important;
      padding: 20px !important;
      margin: 0 auto;
    }

    /* Animazioni di oscillazione attiva da chiusi */
    .circle-1 { animation: floatDynamic1 4.2s ease-in-out infinite !important; }
    .circle-2 { animation: floatDynamic2 4.8s ease-in-out infinite 0.5s !important; }
    .circle-3 { animation: floatDynamic1 5.0s ease-in-out infinite 1.2s !important; }
    .circle-4 { animation: floatDynamic2 4.5s ease-in-out infinite 0.3s !important; }
    .circle-5 { animation: floatDynamic1 5.3s ease-in-out infinite 0.8s !important; }
    .circle-6 { animation: floatDynamic2 4.6s ease-in-out infinite 0.6s !important; }

    /* CERCHI APERTI: dimensione standard base (137.5vw) */
    .geom-shape.active {
      width: 137.5vw !important;
      height: 137.5vw !important;
      max-height: 88vh !important;
      overflow-y: auto !important;
      padding: 85px 65px !important; 
      border-radius: 50% !important;
      transform: translate(-50%, -50%) !important;
      animation: none !important;
    }

    /* WORKING EXPERIENCES: aumentato di un ulteriore 10% (166vw) */
    .circle-1.active {
      width: 166vw !important;
      height: 166vw !important;
      padding: 105px 85px !important;
    }
    .circle-1.active .shape-content {
      max-width: 70% !important;
      margin: 0 auto !important;
      text-align: center !important;
    }
    .circle-1.active .cv-item p {
      text-align: center !important;
      font-size: 0.83rem !important;
      line-height: 1.35 !important;
    }

    .geom-shape.active .shape-inner {
      justify-content: flex-start !important;
      padding-top: 15px;
    }

    /* Informatic Skills allineato al centro */
    .circle-4.active .shape-content,
    .circle-4.active .cv-item,
    .circle-4.active .cv-item h3,
    .circle-4.active .cv-item p {
      text-align: center !important;
    }

    /* EDUCATION: allineamento a sinistra ma con margini protetti dal bordo */
    .circle-2.active {
      padding: 85px 95px !important;
    }
    .circle-2.active .shape-content {
      max-width: 72% !important;
      margin: 0 auto !important;
    }
    .circle-2.active .shape-content,
    .circle-2.active .cv-item,
    .circle-2.active .cv-item h3,
    .circle-2.active .cv-company {
      text-align: left !important;
    }

    /* HOBBIES & INTERESTS: frase finale ristretta */
    .circle-5.active .shape-content {
      max-width: 75% !important;
      margin: 0 auto !important;
      text-align: center !important;
    }
    .circle-5.active .hobbies-outro {
      font-size: 0.82rem !important;
      line-height: 1.35 !important;
    }

    .circle-3.active .lang-row {
      flex-direction: column;
      gap: 8px;
      text-align: center;
      margin-bottom: 20px;
    }
    .circle-3.active .lang-name, 
    .circle-3.active .lang-desc { text-align: center; }
    .circle-3.active .lang-bar { width: 80%; margin: 0 auto; }

    /* CERTIFICATIONS & PROJECTS: disposizione verticale pulita senza linee extra */
    .circle-6.active {
      padding: 95px 75px !important;
    }
    .circle-6.active .shape-content {
      max-width: 78% !important;
      margin: 0 auto !important;
    }
    .split-columns-container {
      grid-template-columns: 1fr !important;
      gap: 28px;
    }
    .circle-6.active .left-column,
    .left-column {
      border-right: none !important;
      border-bottom: none !important;
      padding: 0 !important;
      margin-bottom: 0 !important;
      text-align: center !important;
    }
    .right-column {
      padding: 0 !important;
      text-align: center !important;
    }
    .circle-6.active .split-column .column-subtitle {
      font-size: 1.15rem !important;
      margin-bottom: 14px !important;
      text-align: center !important;
      border-bottom: 2px solid var(--color-primary) !important;
      padding-bottom: 6px !important;
    }
    .circle-6.active .split-column .item-title-primary {
      font-size: 0.98rem !important;
    }
    .circle-6.active .split-column p {
      font-size: 0.82rem !important;
    }
  }