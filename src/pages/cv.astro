---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CV - Portfolio">
  <div class="cv-canvas-container">
    
    <!-- Sfondo/Overlay per intercettare i click all'esterno -->
    <div class="canvas-overlay" id="canvasOverlay"></div>

    <!-- Titolo Curriculum perfettamente al centro dello schermo -->
    <h1 class="page-title">
      <span class="MR-word">Curriculum</span> <span class="dot-word">.</span>
    </h1>

    <!-- Canvas con forme geometriche -->
    <div class="shapes-canvas">

      <!-- 1. Working Experiences (Cerchio) -> Viola Soft (#66629c) -->
      <div class="geom-shape shape-circle" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Working Experiences</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>Engineer / Technical Role</h3>
              <span class="cv-company">Company Name — 2024 - Present</span>
              <p>Gestione di progetti complessi, sviluppo tecnico e integrazione multidisciplinare.</p>
            </div>
            <div class="cv-item">
              <h3>Previous Experience</h3>
              <span class="cv-company">Previous Company — 2021 - 2024</span>
              <p>Attività di analisi, ottimizzazione dei processi e ricerca di soluzioni innovative.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Education (Rettangolo arrotondato) -> Toni del rosso/terracotta (#d97a66) -->
      <div class="geom-shape shape-rect" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Education</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>Master Degree in Engineering</h3>
              <span class="cv-company">University Name — 2015 - 2020</span>
              <p>Percorso accademico focalizzato su materie tecniche, tesi sperimentale e approccio analitico.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Languages (Rombo) -> Cinnamon Buff (#fdc57e) -->
      <div class="geom-shape shape-diamond" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Languages</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>Italian</h3>
              <p>Madrelingua</p>
            </div>
            <div class="cv-item">
              <h3>English</h3>
              <p>Professional Working Proficiency (B2/C1)</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Informatic Skills (Ellisse) -> Pistachio Green luminoso (#648f7b) -->
      <div class="geom-shape shape-ellipse" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Informatic Skills</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>Development & Code</h3>
              <p>Astro, HTML/CSS, Python, Matlab, Scripting</p>
            </div>
            <div class="cv-item">
              <h3>Engineering Tools</h3>
              <p>CAD, Data Analysis Systems, Git, Productivity Software</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Others (Esagono) -> Viola d'accento scuro (#4a4675) -->
      <div class="geom-shape shape-hexagon" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Others</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>Interests & Hobbies</h3>
              <p>Attività outdoor tra lago e montagna, esplorazione tecnologica e progetti maker.</p>
            </div>
            <div class="cv-item">
              <h3>Soft Skills</h3>
              <p>Versatilità, attitudine al problem solving e visione d'insieme.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const shapes = document.querySelectorAll('.geom-shape');
    const overlay = document.getElementById('canvasOverlay');

    function closeAllShapes() {
      shapes.forEach(s => s.classList.remove('active'));
      overlay?.classList.remove('visible');
    }

    shapes.forEach(shape => {
      const closeBtn = shape.querySelector('.close-btn');

      shape.addEventListener('click', () => {
        if (shape.classList.contains('active')) return;

        closeAllShapes();
        shape.classList.add('active');
        overlay?.classList.add('visible');
      });

      closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAllShapes();
      });
    });

    overlay?.addEventListener('click', () => {
      closeAllShapes();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllShapes();
      }
    });
  });
</script>

<style>
  .cv-canvas-container {
    width: 100%;
    max-width: 1400px;
    height: calc(100vh - 90px);
    margin: 0 auto;
    padding: 0 20px 10px 20px;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Titolo perfettamente al centro geometrico dello schermo */
  .page-title {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 3.2rem;
    font-weight: 700;
    margin: 0;
    text-align: center;
    z-index: 2;
    pointer-events: none;
  }

  .MR-word { color: var(--color-primary); }
  .dot-word { color: var(--color-accent); }

  /* Overlay per intercettare i click all'esterno */
  .canvas-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(2px);
    z-index: 900;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .canvas-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .shapes-canvas {
    position: relative;
    width: 100%;
    flex-grow: 1;
    min-height: 550px;
  }

  /* Stile base per ogni geometria */
  .geom-shape {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                width 0.4s ease, 
                height 0.4s ease, 
                border-radius 0.4s ease,
                background-color 0.3s ease;
    box-sizing: border-box;
    padding: 20px;
    overflow: hidden;
    z-index: 5;
  }

  .shape-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .shape-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .shape-content {
    opacity: 0;
    max-height: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    text-align: left;
    width: 100%;
    overflow-y: auto;
  }

  .close-btn {
    display: none;
    position: absolute;
    top: 30px;
    right: 35px;
    background: transparent;
    border: none;
    font-size: 2.2rem;
    cursor: pointer;
    color: inherit;
    z-index: 30;
    line-height: 1;
  }

  /* --- POSIZIONAMENTO E NUOVE TONALITÀ CORRELATE ALLA PALETTE #127 --- */
  .shape-circle {
    width: 220px; height: 220px; border-radius: 50%;
    background-color: var(--color-primary); color: #fcf6ef; /* Viola soft #66629c */
    top: 4%; left: 4%; transform: rotate(-6deg);
    box-shadow: 0 12px 30px rgba(102, 98, 156, 0.25);
  }
  .shape-circle:not(.active):hover { transform: rotate(0deg) scale(1.08); z-index: 10; }

  .shape-rect {
    width: 250px; height: 150px; border-radius: 22px;
    background-color: #d97a66; color: #fcf6ef; /* Toni del rosso/terracotta coordinato */
    top: 4%; right: 4%; transform: rotate(7deg);
    box-shadow: 0 12px 30px rgba(217, 122, 102, 0.25);
  }
  .shape-rect:not(.active):hover { transform: rotate(1deg) scale(1.08); z-index: 10; }

  .shape-diamond {
    width: 240px; height: 240px; background-color: var(--color-secondary); color: #4a3b32; /* Cinnamon Buff #fdc57e */
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
    bottom: 4%; left: 6%; padding: 50px; transform: rotate(12deg);
    box-shadow: 0 12px 30px rgba(253, 197, 126, 0.25);
  }
  .shape-diamond:not(.active):hover { transform: rotate(0deg) scale(1.08); z-index: 10; }

  .shape-ellipse {
    width: 260px; height: 145px; border-radius: 50% / 40%;
    background-color: #648f7b; color: #fcf6ef; /* Pistachio Green meno scuro e luminoso */
    bottom: 8%; left: 34%; transform: rotate(-4deg);
    box-shadow: 0 12px 30px rgba(100, 143, 123, 0.25);
  }
  .shape-ellipse:not(.active):hover { transform: rotate(0deg) scale(1.08); z-index: 10; }

  .shape-hexagon {
    width: 220px; height: 200px; background-color: #4a4675; color: #fcf6ef; /* Viola d'accento scuro */
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    bottom: 4%; right: 6%; padding: 30px; transform: rotate(-5deg);
    box-shadow: 0 12px 30px rgba(74, 70, 117, 0.25);
  }
  .shape-hexagon:not(.active):hover { transform: rotate(0deg) scale(1.08); z-index: 10; }

  /* --- STATO ATTIVO --- */
  .geom-shape.active {
    position: fixed !important;
    top: 50% !important; left: 50% !important;
    transform: translate(-50%, -50%) rotate(0deg) !important;
    z-index: 1000 !important;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4) !important;
    justify-content: flex-start !important;
    align-items: flex-start !important;
  }

  .shape-circle.active { width: 650px !important; height: 650px !important; border-radius: 50% !important; padding: 90px 100px !important; }
  .shape-rect.active { width: 720px !important; height: 460px !important; border-radius: 30px !important; padding: 60px 70px !important; }
  .shape-diamond.active { width: 680px !important; height: 680px !important; padding: 110px 120px !important; background-color: #fef4e8 !important; color: #4a3b32 !important; }
  .shape-ellipse.active { width: 740px !important; height: 480px !important; border-radius: 50% / 40% !important; padding: 70px 90px !important; }
  .shape-hexagon.active { width: 660px !important; height: 660px !important; padding: 110px 120px !important; }

  .geom-shape.active .shape-inner { justify-content: flex-start; align-items: flex-start; }
  .geom-shape.active .shape-title { font-size: 2.1rem; border-bottom: 2px solid currentColor; width: 100%; padding-bottom: 12px; margin-bottom: 20px; }
  .geom-shape.active .shape-content { opacity: 1; max-height: 380px; pointer-events: auto; }
  .geom-shape.active .close-btn { display: block; }

  .cv-item { margin-bottom: 20px; }
  .cv-item h3 { margin: 0 0 4px 0; font-size: 1.2rem; }
  .cv-company { font-size: 0.88rem; opacity: 0.85; display: block; margin-bottom: 6px; }
  .cv-item p { font-size: 1rem; line-height: 1.5; margin: 0; }

  /* --- ADATTAMENTO MOBILE --- */
  @media (max-width: 768px) {
    .cv-canvas-container {
      height: auto !important;
      min-height: 100vh;
      overflow: visible !important;
      padding: 20px 15px 60px 15px;
    }

    .page-title {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      margin: 15px 0 35px 0;
      font-size: 2.5rem;
    }

    .shapes-canvas {
      height: auto !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 25px;
    }

    .geom-shape {
      position: relative !important;
      top: auto !important; 
      left: auto !important; 
      right: auto !important; 
      bottom: auto !important;
      transform: none !important;
      width: 220px !important; 
      height: 220px !important;
      padding: 25px !important;
      margin: 0 auto;
    }

    .shape-circle { border-radius: 50% !important; }
    .shape-rect { width: 260px !important; height: 160px !important; border-radius: 20px !important; }
    .shape-diamond { width: 240px !important; height: 240px !important; clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%) !important; padding: 50px 20px !important; }
    .shape-ellipse { width: 260px !important; height: 160px !important; border-radius: 50% / 40% !important; }
    .shape-hexagon { width: 230px !important; height: 210px !important; clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%) !important; padding: 40px 20px !important; }

    .geom-shape.active {
      width: 90vw !important;
      height: auto !important;
      max-height: 80vh;
      padding: 40px 25px !important;
      border-radius: 24px !important;
    }
  }
</style>