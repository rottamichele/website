---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CV - Portfolio">
  <div class="cv-canvas-container">
    
    <!-- Sfondo/Overlay per intercettare i click all'esterno -->
    <div class="canvas-overlay" id="canvasOverlay"></div>

    <!-- Titolo Curriculum perfettamente al centro dello schermo -->
    <h1 class="page-title">
      <span class="MR-word">Curriculum</span> <span class="dot-word">.</span>
    </h1>

    <!-- Canvas con forme geometriche -->
    <div class="shapes-canvas">

      <!-- 1. Working Experiences (Cerchio) -->
      <div class="geom-shape shape-circle" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title"><span class="highlight-letter">W</span>orking <span class="highlight-letter">E</span>xperiences</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3><span class="highlight-word">Mechanical</span> Designer</h3>
              <span class="cv-company"><span class="highlight-letter">@ SACMI | 2023 - Now</span></span>
              <p>In engineering department I design press for ceramic casting. 
                The journey include mechanical calculations, 3D/2D modelling, FEM analysis, 
                hydraulic and pneumatic systems design. In these processes I work in a 
                multidisciplinary team (mechanical, electrical and automation), 
                interacting with the purchasing department, suppliers and the workshop staff. 
                This implies to work with cost estimations, quotations, project management and people 
                coordination.</p>
            </div>
            <div class="cv-item">
              <h3>Junior Control <span class="highlight-word">Software</span> Engineer</h3>
              <span class="cv-company"><span class="highlight-letter">@ Eldor Corporation | 2020 - 2022</span></span>
              <p>In R&D department I used to develop software control algorithms for static converter 
                (Power Electronics) for automotive industry (onboard battery charger). 
                I worked with hardware and mechanical departments in developing and testing 
                prototypes of different kind of converters (PFC, DC-DC, Buck-Boost, etc.). 
                I’ve been involved in safety analysis, thermal models, laboratory and endurance tests.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Education (Cerchio) -->
      <div class="geom-shape shape-rect" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Education</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>M.Ss Automation and Control Engineer</h3>
              <span class="cv-company">@ Politecnico di Milano | 2017 - 2020</span></div>
            
              <div class="cv-item">  
              <h3>B.Sc Mechatronic Engineer</h3>
              <span class="cv-company">@ Università degli Studi di Padova | 2014 - 2017</span></div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Languages (Cerchio) -->
      <div class="geom-shape shape-star" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Languages</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>Italian 🇮🇹</h3>
              <p>Mother tongue</p>
            </div>
            <div class="cv-item">
              <h3>English 🇬🇧</h3>
              <p>Professional Knowledge</p>
            </div>
            <div class="cv-item">
              <h3>Spanish 🇪🇸</h3>
              <p>Beginner</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Informatic Skills (Cerchio) -->
      <div class="geom-shape shape-ellipse" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Informatic Skills</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>Development & Code</h3>
              <p>Astro, HTML/CSS, Python, Matlab, Scripting</p>
            </div>
            <div class="cv-item">
              <h3>Engineering Tools</h3>
              <p>CAD, Data Analysis Systems, Git, Productivity Software</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Others (Cerchio) -->
      <div class="geom-shape shape-hexagon" tabindex="0">
        <button class="close-btn" aria-label="Chiudi">&times;</button>
        <div class="shape-inner">
          <h2 class="shape-title">Others</h2>
          <div class="shape-content">
            <div class="cv-item">
              <h3>Interests & Hobbies</h3>
              <p>Attività outdoor tra lago e montagna, esplorazione tecnologica e progetti maker.</p>
            </div>
            <div class="cv-item">
              <h3>Soft Skills</h3>
              <p>Versatilità, attitudine al problem solving e visione d'insieme.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const shapes = document.querySelectorAll('.geom-shape');
    const overlay = document.getElementById('canvasOverlay');

    function closeAllShapes() {
      shapes.forEach(s => s.classList.remove('active'));
      overlay?.classList.remove('visible');
    }

    shapes.forEach(shape => {
      const closeBtn = shape.querySelector('.close-btn');

      shape.addEventListener('click', (e) => {
        if (shape.classList.contains('active')) return;

        closeAllShapes();
        shape.classList.add('active');
        overlay?.classList.add('visible');
        e.stopPropagation();
      });

      closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAllShapes();
      });
    });

    overlay?.addEventListener('click', () => {
      closeAllShapes();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllShapes();
      }
    });
  });
</script>

<style>
  .cv-canvas-container {
    width: 100%;
    max-width: 1400px;
    height: calc(100vh - 82px);
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Titolo al centro dello schermo */
  .page-title {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 3.2rem;
    font-weight: 700;
    margin: 0;
    text-align: center;
    z-index: 1;
    pointer-events: none;
  }

  .MR-word { color: var(--color-primary); }
  .dot-word { color: var(--color-accent); }

  /* Overlay per intercettare i click all'esterno */
  .canvas-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(2px);
    z-index: 900;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .canvas-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .shapes-canvas {
    position: relative;
    width: 100%;
    flex-grow: 1;
    min-height: 600px;
  }

  /* Stile base per ogni geometria (cerchi da 250px) */
  .geom-shape {
    position: absolute;
    width: 250px;
    height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    cursor: pointer;
    border-radius: 50%;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                width 0.4s ease, 
                height 0.4s ease, 
                border-radius 0.4s ease,
                background-color 0.3s ease;
    box-sizing: border-box;
    padding: 25px;
    overflow: hidden;
    z-index: 5;
  }

  .shape-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .shape-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .shape-content {
    opacity: 0;
    max-height: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    text-align: left;
    width: 100%;
    overflow-y: auto;
  }

  .close-btn {
    display: none;
    position: absolute;
    top: 30px;
    right: 35px;
    background: transparent;
    border: none;
    font-size: 2.2rem;
    cursor: pointer;
    color: inherit;
    z-index: 30;
    line-height: 1;
  }

  /* --- ANIMAZIONI DI OSCILLAZIONE --- */
  @keyframes floatDynamic1 {
    0% { transform: translate(0, 0); }
    33% { transform: translate(-6px, -9px); }
    66% { transform: translate(7px, 5px); }
    100% { transform: translate(0, 0); }
  }

  @keyframes floatDynamic2 {
    0% { transform: translate(0, 0); }
    33% { transform: translate(9px, -5px); }
    66% { transform: translate(-6px, 8px); }
    100% { transform: translate(0, 0); }
  }

  /* Posizioni asimmetriche (cerchi da 250px) */
  .shape-circle {
    background-color: var(--color-primary); color: #fcf6ef;
    top: 1%; left: 8%;
    animation: floatDynamic1 4.5s ease-in-out infinite;
    box-shadow: 0 12px 30px rgba(102, 98, 156, 0.25);
  }
  .shape-circle:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  .shape-rect {
    background-color: #d97a66; color: #fcf6ef;
    top: 6%; right: 4%;
    animation: floatDynamic2 5s ease-in-out infinite 0.7s;
    box-shadow: 0 12px 30px rgba(217, 122, 102, 0.25);
  }
  .shape-rect:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  .shape-star {
    background-color: var(--color-secondary); color: #fcf6ef;
    bottom: 3%; left: 3%;
    animation: floatDynamic1 5.5s ease-in-out infinite 1.4s;
    box-shadow: 0 12px 30px rgba(253, 197, 126, 0.25);
  }
  .shape-star:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  .shape-ellipse {
    background-color: var(--color-secondary); color: #4a3b32;
    bottom: 12%; left: 32%;
    animation: floatDynamic2 4.8s ease-in-out infinite 0.3s;
    box-shadow: 0 12px 30px rgba(253, 197, 126, 0.25);
  }
  .shape-ellipse:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  .shape-hexagon {
    background-color: #4a4675; color: #fcf6ef;
    bottom: 5%; right: 12%;
    animation: floatDynamic1 5.2s ease-in-out infinite 1s;
    box-shadow: 0 12px 30px rgba(74, 70, 117, 0.25);
  }
  .shape-hexagon:not(.active):hover { animation-play-state: paused; transform: scale(1.06); z-index: 10; }

  /* --- STATO ATTIVO GENERALE --- */
  .geom-shape.active {
    position: fixed !important;
    top: 50% !important; 
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    animation: none !important;
    z-index: 1000 !important;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4) !important;
  }

  .geom-shape.active .shape-content {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .geom-shape.active .close-btn {
    display: block !important;
  }

  /* --- STATO ATTIVO SPECIFICO PER IL CERCHIO (Working Experiences) --- */
  .shape-circle.active { 
    width: min(95vw, 95vh) !important; 
    height: min(95vw, 95vh) !important; 
    border-radius: 50% !important; 
    padding: 60px 80px !important; 
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
  }

  .shape-circle.active .shape-inner { 
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important; 
    align-items: center !important; 
    text-align: center !important;
    width: 100% !important;
    height: 100% !important;
  }

  .shape-circle.active .shape-title { 
    font-size: 1.8rem; 
    border-bottom: 2px solid var(--color-accent); 
    width: 60%; 
    margin: 0 auto 15px auto !important; 
    padding-bottom: 8px; 
    text-align: center;
  }
  
  .shape-circle.active .highlight-letter { color: var(--color-accent); }
  .shape-circle.active .highlight-word { color: var(--color-accent); }

  .shape-circle.active .shape-content { 
    max-height: none !important; 
    overflow-y: visible !important;
    width: 100% !important;
  }

  .shape-circle.active .cv-item { 
    margin-bottom: 15px; 
    text-align: center; 
  }
  .shape-circle.active .cv-item h3 { margin: 0 0 2px 0; font-size: 1.1rem; text-align: center; }
  .shape-circle.active .cv-company { font-size: 0.82rem; opacity: 0.85; display: block; margin-bottom: 4px; text-align: center; }
  
  .shape-circle.active .cv-item p { 
    font-size: 0.88rem; 
    line-height: 1.4; 
    margin: 0 auto; 
    max-width: 650px;
    text-align: justify; 
    text-justify: inter-word;
  }

  /* Stati attivi per gli altri cerchi (Education, Languages, Skills, Others) */
  .shape-rect.active,
  .shape-star.active,
  .shape-ellipse.active,
  .shape-hexagon.active { 
    width: min(90vw, 90vh) !important; 
    height: min(90vw, 90vh) !important; 
    border-radius: 50% !important; 
    padding: 70px 90px !important; 
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
  }

  /* Specifico per Languages con testo chiaro */
  .shape-star.active { 
    background-color: var(--color-secondary) !important; 
    color: #fcf6ef !important; 
  }
  .shape-star.active .shape-inner { display: flex !important; flex-direction: column !important; justify-content: center !important; align-items: center !important; text-align: center !important; width: 100% !important; height: 100% !important; }
  .shape-star.active .shape-title { font-size: 2rem; border-bottom: 2px solid #fcf6ef; width: 60%; margin: 0 auto 20px auto !important; padding-bottom: 10px; text-align: center !important; color: #fcf6ef !important; }
  .shape-star.active .shape-content { max-height: none !important; overflow-y: visible !important; width: 100% !important; text-align: center !important; }
  .shape-star.active .cv-item { margin-bottom: 18px; text-align: center !important; }
  .shape-star.active .cv-item h3 { margin: 0 0 4px 0; font-size: 1.2rem; text-align: center !important; color: #fcf6ef !important; }
  .shape-star.active .cv-item p { margin: 0; font-size: 1rem; text-align: center !important; color: #fcf6ef !important; opacity: 0.95; }

  /* Adattamento interno per le altre schede circolari attive */
  .shape-rect.active .shape-inner,
  .shape-ellipse.active .shape-inner,
  .shape-hexagon.active .shape-inner { 
    justify-content: center !important; 
    align-items: center !important; 
    text-align: center !important; 
  }
  .shape-rect.active .shape-title,
  .shape-ellipse.active .shape-title,
  .shape-hexagon.active .shape-title { 
    font-size: 1.8rem; 
    border-bottom: 2px solid currentColor; 
    width: 60%; 
    margin: 0 auto 15px auto !important; 
    padding-bottom: 8px; 
    text-align: center !important; 
  }
  .shape-rect.active .shape-content,
  .shape-ellipse.active .shape-content,
  .shape-hexagon.active .shape-content { 
    max-height: none !important; 
    overflow-y: visible !important; 
    text-align: center !important; 
  }
  .shape-rect.active .cv-item,
  .shape-ellipse.active .cv-item,
  .shape-hexagon.active .cv-item { 
    text-align: center !important; 
    margin-bottom: 15px; 
  }
  .shape-rect.active .cv-item h3,
  .shape-ellipse.active .cv-item h3,
  .shape-hexagon.active .cv-item h3 { 
    text-align: center !important; 
    margin: 0 0 4px 0; 
  }
  .shape-rect.active .cv-item p,
  .shape-ellipse.active .cv-item p,
  .shape-hexagon.active .cv-item p { 
    text-align: center !important; 
    margin: 0 auto; 
    max-width: 600px; 
  }

  .cv-item { margin-bottom: 20px; }

  /* --- ADATTAMENTO MOBILE --- */
  @media (max-width: 768px) {
    .cv-canvas-container {
      height: auto !important;
      min-height: 100vh;
      overflow: visible !important;
      padding: 20px 15px 60px 15px;
    }

    .page-title {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      margin: 15px 0 35px 0;
      font-size: 2.5rem;
    }

    .shapes-canvas {
      height: auto !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 25px;
    }

    .geom-shape {
      position: relative !important;
      top: auto !important; 
      left: auto !important; 
      right: auto !important; 
      bottom: auto !important;
      transform: none !important;
      width: 220px !important; 
      height: 220px !important;
      border-radius: 50% !important;
      padding: 20px !important;
      margin: 0 auto;
      animation: none !important;
    }

    .geom-shape.active {
      width: 90vw !important;
      height: auto !important;
      max-height: 85vh;
      overflow-y: auto !important;
      padding: 30px 20px !important;
      border-radius: 50% !important;
    }
  }
</style>