---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Cervino #2 - Portfolio">
  <div class="project-detail-container">
    
    <a href="/portfolio" class="back-link">← Back to Portfolio</a>

    <div class="project-header">
      <h2 class="project-title">Cervino #2</h2>
      <span class="project-year">2022</span>
    </div>

    <!-- Descrizione a tutta larghezza -->
    <div class="project-text-full">
      <p class="project-description">
        I'm deeply attached to this big guy (the Matterhorn, il Cervino).<br>
        As I said for <a href="cervino1" class="portfolio-link">Cervino #1</a>, I spent 3 summer seasons looking at it. 
        I decided to give it to a friend with whom I shared those times.
        This time I tried to experiment a new technique that I founded online.
        Fist I copied the profile and then I divided it into portions with the purpose of different wood lines orientation.
        <br><br>
        The Matterhorn illuminated my the moon is impossible to forget.
    </p>
    </div>

    <!-- Due foto affiancate della stessa altezza senza zoom al passaggio del mouse -->
    <div class="project-images-row">
        <img src="/images/cervino1/IMG_1504.PNG" alt="cerv2" class="row-img" />
      <img src="/images/cervino2/IMG_2920.jpeg" alt="cerv1" class="row-img" />
      <img src="/images/cervino2/IMG_2930.jpeg" alt="cerv2" class="row-img" />
      <img src="/images/cervino2/IMG_2934.jpeg" alt="cerv2" class="row-img" />
    </div> <br>
    <div class="project-images-row">
      <img src="/images/cervino2/IMG_2935.jpeg" alt="cerv1" class="row-img" />
      <img src="/images/cervino2/IMG_2941.jpeg" alt="cerv2" class="row-img" />
    </div>
    <br>
    <div class="project-images-row">
      <img src="/images/cervino2/IMG_2952.jpeg" alt="cerv1" class="row-img" />
      <img src="/images/cervino2/IMG_2955.jpeg" alt="cerv2" class="row-img" />
    </div>
  </div>
</BaseLayout>

<style>
  .project-detail-container {
    width: 100%;
    max-width: 950px;
    margin: 0 auto;
    padding: 50px 20px 80px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .back-link {
    text-decoration: none;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 25px;
    display: inline-block;
    transition: color 0.2s ease;
  }
  .back-link:hover { 
    color: var(--color-accent);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid rgba(100, 143, 123, 0.3);
    padding-bottom: 15px;
    margin-bottom: 30px;
  }

  .project-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .project-year {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Blocco descrizione a larghezza piena */
  .project-text-full {
    width: 100%;
    margin-bottom: 40px;
  }

  .project-description {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
  }

  /* Griglia a due colonne per affiancare le immagini */
  .project-images-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    width: 100%;
  }

  .row-img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    display: block;
    
  }

  .portfolio-link { 
    color: var(--color-accent); 
    font-weight: 700; 
    text-decoration: underline; 
    transition: opacity 0.2s ease; 
}

  /* Su smartphone le due immagini si impilano una sotto l'altra */
  @media (max-width: 768px) {
    .project-images-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .row-img {
      height: 300px;
    }
  }
</style>