---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Duomo - Portfolio">
  <div class="project-detail-container">
    
    <a href="/portfolio" class="back-link">← Torna al Portfolio</a>

    <div class="modal-header">
      <h2 class="modal-title">Duomo</h2>
      <span class="modal-year">2021</span>
    </div>

    <div class="modal-body-split">
      <div class="modal-photo-box">
        <img src="/images/duomomilano.jpg" alt="Duomo" />
      </div>

      <div class="modal-text-box">
        <p class="modal-description">
          Un progetto incentrato sulla documentazione visiva e architettonica, esplorando le linee e la maestosità della struttura. 
          Puoi duplicare facilmente questo file per ogni nuovo progetto che aggiungerai in autonomia.
        </p>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .project-detail-container {
    width: 100%;
    max-width: 950px;
    margin: 0 auto;
    padding: 50px 20px 80px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .back-link {
    text-decoration: none;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 25px;
    display: inline-block;
    transition: color 0.2s ease;
  }
  .back-link:hover { 
    color: var(--color-accent);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid rgba(100, 143, 123, 0.3);
    padding-bottom: 15px;
    margin-bottom: 25px;
  }

  .modal-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .modal-year {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .modal-body-split {
    display: flex;
    gap: 40px;
    align-items: center;
  }

  .modal-photo-box {
    flex: 1;
    height: 350px;
    background-color: var(--color-secondary);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
  }

  .modal-photo-box img {
    max-width: 85%;
    max-height: 85%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .modal-text-box {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .modal-description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  @media (max-width: 768px) {
    .modal-body-split {
      flex-direction: column;
    }
    .modal-photo-box {
      width: 100%;
      height: 250px;
    }
  }
</style>