---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="HOP - Portfolio">
  <div class="project-detail-container">
    
    <a href="/portfolio" class="back-link">← Back to Portfolio</a>

    <div class="project-header">
      <h2 class="project-title">Hop</h2>
      <span class="project-year">2022</span>
    </div>

    <!-- Descrizione a tutta larghezza -->
    <div class="project-text-full">
      <p class="project-description">
        When the swimming pool in my parents garden broke, I decided to reuse the cover and make painting canvas.
        For sure as I'm terrible as a painter. So, I find out a simple subject for experimenting. 
        The idea was to make an hop flower, but someone saw an artichoke in it. Points of view.
      </p>
    </div>

    <!-- Due foto affiancate della stessa altezza senza zoom al passaggio del mouse -->
    <div class="project-images-row">
      <img src="/images/hop/DSCF8403.jpg" alt="hop1" class="row-img" />
      <img src="/images/hop/DSCF8404.jpg" alt="hop2" class="row-img" />
    </div>

  </div>
</BaseLayout>

<style>
  .project-detail-container {
    width: 100%;
    max-width: 950px;
    margin: 0 auto;
    padding: 50px 20px 80px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .back-link {
    text-decoration: none;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 25px;
    display: inline-block;
    transition: color 0.2s ease;
  }
  .back-link:hover { 
    color: var(--color-accent);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid rgba(100, 143, 123, 0.3);
    padding-bottom: 15px;
    margin-bottom: 30px;
  }

  .project-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .project-year {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Blocco descrizione a larghezza piena */
  .project-text-full {
    width: 100%;
    margin-bottom: 40px;
  }

  .project-description {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
  }

  /* Griglia a due colonne per affiancare le immagini */
  .project-images-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    width: 100%;
  }

  .row-img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    display: block;
    
  }

  /* Su smartphone le due immagini si impilano una sotto l'altra */
  @media (max-width: 768px) {
    .project-images-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .row-img {
      height: 300px;
    }
  }
</style>