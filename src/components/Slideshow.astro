---
// Elenco delle immagini (puoi aggiungerne altre in futuro)
const images = [
  "/images/IMG_8469.jpg",
  "/images/IMG_4784.jpg",
  "/images/IMG_6670.jpg",
  "/images/IMG_6872.jpg",
  "/images/IMG_7434.jpg",
  "/images/IMG_8423.jpg"
];
---
<div class="slideshow-container">
	{images.map((img, index) => (
	  <img 
		src={img} 
		alt="Foto portfolio" 
		class={`slide ${index === 0 ? 'active' : ''}`} 
	  />
	))}
  </div>
  
  <script>
	document.addEventListener("DOMContentLoaded", () => {
	  const slides = document.querySelectorAll(".slide");
	  let currentIndex = 0;
  
	  if (slides.length > 1) {
		setInterval(() => {
		  slides[currentIndex].classList.remove("active");
		  currentIndex = (currentIndex + 1) % slides.length;
		  slides[currentIndex].classList.add("active");
		}, 1000); // 2 secondo
	  }
	});
  </script>
  
  <style>
	/* Contenitore quadrato fisso */
	.slideshow-container {
	  position: relative;
	  width: 400px;
	  height: 400px;
	  background-color: #e5ded5;
	  border-radius: 4px;
	  overflow: hidden;
	  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
	}
  
	/* Immagini sovrapposte che riempiono perfettamente il quadrato */
	.slide {
	  position: absolute;
	  top: 0;
	  left: 0;
	  width: 100%;
	  height: 100%;
	  object-fit: cover; /* Taglia l'immagine in modo che riempia il quadrato senza deformarsi */
	  opacity: 0;
	  transition: opacity 0.6s ease-in-out;
	}
  
	.slide.active {
	  opacity: 1;
	}
  </style>